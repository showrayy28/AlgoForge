# CodeEzz Backend — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git. This file (.env.example) is safe to commit.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# In development: http://localhost:5173
# In production: your Vercel/Netlify frontend URL
CORS_ORIGIN=http://localhost:5173

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
DB_CONNECT_STRING=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/codeezz

# ─── JSON Web Token ──────────────────────────────────────────────────────────
# Generate a strong 64-char secret with: node -e "require('crypto').randomBytes(32).toString('hex')|Write-Host"
JWT_KEY=your_64_character_hex_secret_here

# ─── Redis Cloud ──────────────────────────────────────────────────────────────
# Get from: https://app.redislabs.com → Database → Security
REDIS_PASS=your_redis_cloud_password

# ─── Judge0 (RapidAPI) ───────────────────────────────────────────────────────
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_KEY=your_rapidapi_key

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_KEY=AIzaSy...

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Get from: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Stripe Payment (Phase 4) ────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Razorpay Payment (Phase 4, India) ───────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
